# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave empty to use SQLite (db.sqlite3).
# From M02 on: postgres://tpdc:tpdc@localhost:5432/tpdc
DATABASE_URL=

# LLM provider: openai_compatible | mock
LLM_PROVIDER=mock
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# Vision model; empty base URL / key fall back to the text ones above.
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=qwen-vl-plus
LLM_TIMEOUT_SECONDS=60

# Business rules
COMPANY_SKU_PREFIX=FIT-
DEFAULT_MARGIN=0.25
